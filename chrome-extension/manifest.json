{
  "manifest_version": 3,
  "name": "AutoIPO Browser Bridge",
  "description": "Connects the AutoIPO app to Chrome: opens the target website and drives its pages with trusted input through the DevTools protocol (debugger permission).",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "activeTab", "scripting", "sidePanel", "debugger", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open the AutoIPO side panel"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
